# TravelPilot Environment Configuration Example
# Copy this file to .env and fill in your API keys before running.

# Required for AI Itinerary Generation & Chat Assistant
# Get key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Default Gemini model (e.g. gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Required for Web Search Tool (Attractions, Events, Local Info)
# Get key from Tavily: https://tavily.com/
TAVILY_API_KEY=

# Optional: Google Maps & Places API key for real geocoding and transit estimates
# Get key from Google Cloud Console: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=

# Optional: Weather API key (OpenWeatherMap)
# Get key from OpenWeather: https://openweathermap.org/api
WEATHER_API_KEY=

# Database Configuration (Defaults to local SQLite if not specified)
# For PostgreSQL: postgresql://user:password@localhost:5432/travelpilot
DATABASE_URL=sqlite:///./travelpilot.db

# JWT Secret Key for User Authentication
JWT_SECRET=super-secret-travelpilot-jwt-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
